Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 38; 45
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Ground
      Enabled: true
      # 10 m x 10 m patch at the world origin, as in the course RViz config.
      Cell Size: 1
      Plane Cell Count: 10
      Color: 160; 160; 164
      Alpha: 0.6
    - Class: rviz/TF
      Name: Desired frame
      Enabled: true
      Frame Timeout: 1
      # Red/green/blue x/y/z axes with frame names, no parent-link arrows.
      Marker Scale: 5
      Show Arrows: false
      Show Axes: true
      Show Names: true
    - Class: rviz/Odometry
      Name: Actual vehicle
      Enabled: true
      Topic: /current_state
      # Body-frame axes along the flight: one every 0.1 m or 0.1 rad, last 100.
      Keep: 100
      Shape:
        Value: Axes
        Axes Length: 1
        Axes Radius: 0.1
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
    - Class: rviz/Path
      Name: Actual path
      Enabled: true
      Topic: /flight/actual
      Color: 40; 210; 255
      Line Style: Lines
      Line Width: 0.05
      Buffer Length: 1
    - Class: rviz/Path
      Name: Desired circle
      Enabled: true
      Topic: /flight/desired
      Color: 255; 185; 45
      Line Style: Lines
      Line Width: 0.05
      Buffer Length: 1
    - Class: rviz/Marker
      Name: Simulation source
      Enabled: true
      Marker Topic: /flight/source
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 17
      Pitch: 0.9
      Yaw: 0.7
      Focal Point:
        X: 0
        Y: 0
        Z: 1.5
      Target Frame: world
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
Window Geometry:
  Width: 1280
  Height: 800
