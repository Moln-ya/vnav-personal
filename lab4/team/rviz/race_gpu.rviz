Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 38; 45
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Ground
      Enabled: true
      Cell Size: 2
      Plane Cell Count: 40
      Color: 100; 110; 120
      Offset:
        X: -24
        Y: 3
        Z: 0
    - Class: rviz/TF
      Name: Desired frame
      Enabled: true
      Frame Timeout: 1
      Marker Scale: 2
      Show Arrows: false
      Show Axes: true
      Show Names: false
    - Class: rviz/PoseArray
      Name: Gates
      Enabled: true
      Topic: /desired_traj_vertices
      Shape: Arrow (3D)
      Color: 230; 60; 60
      Alpha: 1
      Arrow Length: 3
      Shaft Radius: 0.25
      Head Radius: 0.6
      Head Length: 1
    - Class: rviz/Path
      Name: Planned trajectory
      Enabled: true
      Topic: /desired_path
      Color: 255; 185; 45
      Line Style: Billboards
      Line Width: 0.08
      Buffer Length: 1
    - Class: rviz/Path
      Name: Actual path
      Enabled: true
      Topic: /race/actual
      Color: 40; 210; 255
      Line Style: Billboards
      Line Width: 0.12
      Buffer Length: 1
    - Class: rviz/Odometry
      Name: Actual vehicle
      Enabled: true
      Topic: /current_state
      Keep: 1
      Shape:
        Value: Axes
        Axes Length: 2
        Axes Radius: 0.15
      Position Tolerance: 0
      Angle Tolerance: 0
    - Class: rviz/Marker
      Name: Simulation source
      Enabled: true
      Marker Topic: /race/source
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 72
      Pitch: 1.15
      Yaw: 4.71
      Focal Point:
        X: -24
        Y: 2.5
        Z: 0
      Target Frame: world
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
Window Geometry:
  Width: 1280
  Height: 800
